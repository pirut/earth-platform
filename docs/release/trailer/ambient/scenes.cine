out @OUT@
fps 30
# Ambient scenes: each place gets a small built set in front of the landscape (Cinema run/at lines).
# Clear boxes cover the camera path; each shot is a slow ~8 m push-in so the near set stays in frame.
# Teton dropped after four tries: a generated village sits on Mormon Row and the barn either hid behind it or hid the range.

# Yosemite Valley from Valley View: a small campsite (campfire smoke, log seats) with the valley walls behind; looking east.
shot yosemite frames=1200 settle=35 warm=240 clear=2 ease=0 time=1500 fov=50
cam 0 37.7172 -119.6633 +2.5
cam 1 37.71722 -119.66321 +2.5
look 0 37.7300 -119.6000 =1500
look 1 37.7300 -119.6000 =1500
at C 37.7172 -119.6633
run fill {C:-10:-4:-15} {C:45:17:10} air replace #minecraft:leaves
run fill {C:-10:-4:-15} {C:45:17:10} air replace #minecraft:logs
run fill {C:-10:-4:-15} {C:45:17:10} air replace tall_grass
run fill {C:-10:-4:-15} {C:45:17:10} air replace short_grass
run fill {C:-10:-4:-15} {C:45:17:10} air replace fern
run fill {C:-10:-4:-15} {C:45:17:10} air replace large_fern
run fill {C:-10:-4:-15} {C:45:17:10} air replace #minecraft:flowers
run fill {C:-10:-4:-15} {C:45:17:10} air replace azalea
run fill {C:-10:-4:-15} {C:45:17:10} air replace flowering_azalea
run fill {C:-10:18:-15} {C:45:30:10} air replace #minecraft:leaves
run fill {C:-10:18:-15} {C:45:30:10} air replace #minecraft:logs
run fill {C:-10:18:-15} {C:45:30:10} air replace tall_grass
run fill {C:-10:18:-15} {C:45:30:10} air replace short_grass
run fill {C:-10:18:-15} {C:45:30:10} air replace fern
run fill {C:-10:18:-15} {C:45:30:10} air replace large_fern
run fill {C:-10:18:-15} {C:45:30:10} air replace #minecraft:flowers
run fill {C:-10:18:-15} {C:45:30:10} air replace azalea
run fill {C:-10:18:-15} {C:45:30:10} air replace flowering_azalea
run setblock {C:14:0:-2} campfire
run setblock {C:14:0:0} stripped_spruce_log[axis=x]
run setblock {C:15:0:0} stripped_spruce_log[axis=x]
run setblock {C:16:0:-3} stripped_spruce_log[axis=z]
run setblock {C:16:0:-2} stripped_spruce_log[axis=z]

# Matterhorn over the Riffelsee: a bench and a lantern on the lakeshore; looking west.
shot matterhorn frames=1200 settle=35 warm=240 clear=2 ease=0 time=1500 fov=40
