out @OUT@
fps 30
preview 3
# Hook Shorts on build 47: a 1:1 scale pull-back, five 5 s "guess the place" clips and a Grand Canyon descent.
# Every shot sets fov, since the game keeps the last one between shots.

# 1:1 scale: a person-sized armor stand on the Hornli ridge at the hut, Matterhorn behind;
# pull back and up until the whole mountain fits.
shot scale frames=300 settle=95 warm=600 clear=2 ease=1 time=1500 fov=70 hold=15
cam 0 45.98203 7.67448 +2.0
# Keys evenly spaced along the line out, so the spline never swings back into the ridge.
cam 0.1 45.98383 7.67803 =3420
cam 0.3 45.98742 7.68514 =3700
cam 0.6 45.99281 7.69579 =4150
cam 1 46.00000 7.71000 =4600
look 0 45.9763 7.6586 =3550
look 0.3 45.9763 7.6586 =3900
look 1 45.9763 7.6586 =3700
at P 45.98200 7.67440
run summon armor_stand {P} {ShowArms:1b,NoGravity:1b,Rotation:[60f,0f],ArmorItems:[{id:"leather_boots"},{id:"leather_leggings"},{id:"leather_chestplate"},{id:"player_head"}]}

# Guess the place: wide, recognizable views, slow drift, 150 frames each.
shot q-grand_canyon frames=150 settle=95 warm=600 clear=2 ease=0 time=1500 fov=50
cam 0 36.0700 -112.1050 =2350
cam 1 36.0760 -112.1020 =2350
look 0 36.1050 -112.0950 =1100
look 1 36.1080 -112.0920 =1100

# North face from above the Rongbuk glacier.
shot q-everest frames=150 settle=95 warm=600 clear=2 ease=0 time=3000 fov=50
cam 0 28.0900 86.8550 =6900
cam 1 28.0880 86.8610 =6900
look 0 27.9881 86.9250 =7700
look 1 27.9881 86.9250 =7700

shot q-uluru frames=150 settle=95 warm=600 clear=2 ease=0 time=12300 fov=50
cam 0 -25.3600 131.0000 =750
cam 1 -25.3585 131.0060 =740
look 0 -25.3444 131.0369 =800
look 1 -25.3444 131.0369 =800

# From just past Glacier Point, in afternoon light.
shot q-half_dome frames=150 settle=95 warm=600 clear=2 ease=0 time=9000 fov=50
cam 0 37.7300 -119.5730 =2350
cam 1 37.7312 -119.5700 =2350
look 0 37.7459 -119.5332 =2300
look 1 37.7459 -119.5332 =2300

# Low over Lake Kawaguchi, drifting west along the water.
shot q-fuji frames=150 settle=95 warm=600 clear=2 ease=0 time=1500 fov=50
cam 0 35.5150 138.7520 +30
cam 1 35.5152 138.7500 +30
look 0 35.3606 138.7274 =2300
look 1 35.3606 138.7274 =2300

# Grand Canyon descent: low and fast from the South Rim at the Bright Angel trailhead, down Garden Creek past Havasupai Gardens,
# east over the Tonto Plateau (above the Pipe Creek gorge, which is too narrow to fly), then over the edge of the Inner Gorge
# to the river, ending low over the water looking upstream toward Phantom Ranch. Keys are spaced by distance so the speed stays even.
shot walk frames=600 settle=95 warm=600 clear=2 ease=0 time=1500 fov=70 hold=15
cam 0.000 36.0575 -112.1436 +3
cam 0.124 36.0640 -112.1380 +25
cam 0.226 36.0700 -112.1350 +25
cam 0.347 36.0770 -112.1310 +25
