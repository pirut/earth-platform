run fill {C:-10:7:-5} {C:60:11:80} air replace #minecraft:logs
run fill {C:-10:12:-5} {C:60:16:80} air replace #minecraft:leaves
run fill {C:-10:12:-5} {C:60:16:80} air replace #minecraft:logs
run fill {C:-10:17:-5} {C:60:21:80} air replace #minecraft:leaves
run fill {C:-10:17:-5} {C:60:21:80} air replace #minecraft:logs
run fill {C:-10:22:-5} {C:60:26:80} air replace #minecraft:leaves
run fill {C:-10:22:-5} {C:60:26:80} air replace #minecraft:logs
